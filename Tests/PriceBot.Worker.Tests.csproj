<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- NPOI, test projesinde SADECE .xls fixture'ları yazmak için kullanılıyor (üretim kodu
         NPOI'ye bağımlı değil, sadece okuma için ExcelDataReader kullanıyor). -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ExcelPriceReader.cs" />
    <Compile Include="..\BrandMatcher.cs" />
    <!-- GeminiVisionClassifier.cs'in TAMAMI DEĞİL, sadece saf/network-SkiaSharp'sız partial
         kısmı (bkz. GeminiVisionClassifierLabelResolver.cs dosya başı yorumu) — ana dosya
         SkiaSharp 2.88.8 kullanıyor, test projesi NPOI üzerinden 3.x'e bağımlı; ikisini
         aynı derlemede birleştirmek NU1605 sürüm çakışmasına yol açardı. -->
    <!-- RetryDelayParser.cs: Gemini/Groq/Anthropic'in 429 yanıt metnini paylaşılan ayrıştırıcısı,
         hiçbir native/SkiaSharp bağımlılığı yok. -->
    <Compile Include="..\RetryDelayParser.cs" />
    <Compile Include="..\GeminiVisionClassifierLabelResolver.cs" />
    <!-- AnthropicVisionClassifier.cs'in TAMAMI DEĞİL, sadece saf/network-SkiaSharp'sız partial
         kısmı — GeminiVisionClassifierLabelResolver.cs ile AYNI gerekçe (yukarıdaki yorum). -->
    <Compile Include="..\AnthropicVisionClassifierLabelResolver.cs" />
    <!-- GroqVisionClassifier.cs'in TAMAMI DEĞİL, sadece saf/network-SkiaSharp'sız partial kısmı —
         AYNI gerekçe (yukarıdaki yorum). -->
    <Compile Include="..\GroqVisionClassifierLabelResolver.cs" />
    <!-- PaddleScanOcr.cs'in TAMAMI DEĞİL, sadece motor-bağımsız aday çıkarma/eşleştirme/fuzzy
         partial'ı (bkz. PaddleScanOcrMatching.cs dosya başı yorumu) — ana dosya OpenCvSharp/
         Sdcb.PaddleOCR'a bağımlı, bu native paketleri test projesine sürüklemeden
         ComputeFuzzyCandidates gibi saf mantığı doğrudan test edebilmek için ayrıldı. -->
    <Compile Include="..\PaddleScanOcrMatching.cs" />
    <!-- IOcrEngine.cs: CodeMatch/ScanResult record'ları — PaddleScanOcrMatching.cs bunlara
         bağımlı, native paket gerektirmiyor. -->
    <Compile Include="..\IOcrEngine.cs" />
  </ItemGroup>

</Project>
